# Copia este archivo como .env y ajusta los valores. El .env NO se sube a GitHub.

# Proveedor de IA: "ollama" (gratis, local) u "openai" (requiere API key)
IA_PROVEEDOR=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:3b

OPENAI_API_KEY=
OPENAI_MODELO=gpt-4o-mini

# PostgreSQL (el de docker-compose.yml; usuario y clave solo para desarrollo local)
DATABASE_URL=postgresql+psycopg://facturas:facturas@localhost:5432/facturas
